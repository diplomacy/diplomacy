{
    "plugins": [
        "react"
    ],
    "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "env": {
        "es6":     true,
        "browser": true,
        "node":    true,
        "mocha":   true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended"
    ],
    "settings": {"react": {"version": "16.14"}},
    "overrides": [{"files": ["**/*.test.js", "**/*.test.jsx"], "env": {"jest": true}}],
    "rules": {
        "semi": [2, "always", { "omitLastInOneLineBlock": true}]
    }
}
